GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=cole-sua-chave-aqui

# Padrão: Gemini (precisa da GOOGLE_API_KEY acima + just chave).
ADK_BACKEND=gemini

# Opcional — modelo local (just local-serve + just web-local):
# ADK_BACKEND=local
# LOCAL_API_BASE=http://127.0.0.1:3000/v1
# LOCAL_MODEL=openai/Qwen/Qwen2.5-1.5B-Instruct
